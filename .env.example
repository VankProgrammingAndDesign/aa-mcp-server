# Control Room credentials — needed only for the Control Room tools (list_bots,
# deploy_bot, queues, run history). For OFFLINE use (bot-package analysis + UiPath
# migration only) they are optional: omit them entirely and the server still
# starts; the Control Room tools then return a clear "not configured" error.
AA_CONTROL_ROOM_URL=https://your-tenant.automationanywhere.digital
AA_USERNAME=your.username@company.com
AA_API_KEY=your-40-character-api-key-here
AA_TOKEN_REFRESH_BUFFER_SECONDS=60
AA_HTTP_TIMEOUT_SECONDS=30
AA_LOG_LEVEL=WARNING
# AA_SSL_VERIFY=false  # Set to false if your Control Room uses an internal/self-signed certificate
